# Sao chép thành .env.local để chạy `npm run dev`.
# Trên GitHub, đặt 2 giá trị này ở repo Settings → Secrets and variables → Actions → Variables.

# URL Web App Apps Script (…/exec) sau khi Deploy
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# OAuth 2.0 Client ID loại "Ứng dụng web" (cùng cái điền trong KPI_CHAM_CLIENT_ID của Apps Script)
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
